# User-Agent sent on every HTTP request to Wikimedia servers.
# Wikimedia policy requires: ToolName/version (URL; contact-email)
# See: https://www.mediawiki.org/wiki/API:Etiquette#The_User-Agent_header
# The trailing "python-httpx/x.x" identifies the HTTP library actually used.
WIKIMEDIA_USER_AGENT=YourBotName/1.0 (https://your-project-url.example.com/; your-email@example.com) python-httpx

# --- Dump source (wikidata_dump_etl.py / run_etl.sh) ---
#
# Three valid combinations:
#
#   1. DUMP_URL only
#      The dump is streamed from HTTP for each of the 3 passes.
#      Nothing is written to disk. Requires network for every pass.
#
#   2. DUMP_FILE only (file must already exist on the shared volume)
#      The local .bz2 file is read for each of the 3 passes.
#      The file is never fully decompressed; it is streamed chunk by chunk.
#
#   3. DUMP_FILE + DUMP_URL
#      If DUMP_FILE does not exist yet, it is downloaded from DUMP_URL first.
#      All 3 passes then read from the local file (saving bandwidth).
#      If DUMP_FILE already exists, DUMP_URL is ignored.
#
# In all cases the .bz2 is decompressed in streaming chunks; the full
# decompressed content is never stored on disk.

DUMP_URL=https://dumps.wikimedia.org/wikidatawiki/entities/latest-all.json.bz2
DUMP_FILE=/shared/latest-all.json.bz2

# --- Database connection (used by the staging-load script after ETL) ---
# Also used by wikidata_dump_etl.py to write live progress to SERVER_VARIABLE.
# Names match the sibling repos (sparql-crawler, tmdb-crawler) and citizenphil.
# If DB_HOST is not set, server variable tracking is silently disabled.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=your_mysql_username
# DB_PASSWORD=your_mysql_password
# DB_NAME=your_database_name

# DB_NAMESPACE: table name prefix used by citizenphil (e.g. "T_WC_" → T_WC_SERVER_VARIABLE).
# Leave empty if SERVER_VARIABLE has no prefix.
# DB_NAMESPACE=T_WC_

# IMPORT_BATCH_ID=weekly_2026_03_13

# --- V1 backfill seed (WIKIDATA-CRAWLER-023) ---
# Step 106 rebuilds, from T_WC_WIKIDATA_ITEM_V1, the list of items to cache on top of
# what pass2 referenced, so that deleting the V1 tables removes no label from the
# screen. On by default, and it needs the DB_* settings above.
#   V1_BACKFILL_SEED=0        run item_cache on pass2 references only
#   V1_BACKFILL_MIN_IDS=100000  floor below which step 106 refuses to start, rather
#                               than running 23 h and silently seeding nothing
# V1_BACKFILL_SEED=1
# V1_BACKFILL_MIN_IDS=100000

# To run pass1, set these values:
#PASS_NAME=pass1
#OUT_DIR=/shared/pass1

# To run pass2, set these values: 
#PASS_NAME=pass2
#OUT_DIR=/shared/pass2
#CLASS_ROOTS_JSON=/shared/pass1/class_roots.jsonl
#CORE_ENTITY_IDS=/shared/pass1/core_entity_ids.txt
#CANDIDATE_PERSON_IDS=/shared/pass1/candidate_person_ids.txt

# To run item_cache, set these values: 
#PASS_NAME=item_cache
#OUT_DIR=/shared/item_cache
#CORE_ENTITY_IDS=/shared/pass1/core_entity_ids.txt
#REFERENCED_ITEM_IDS=/shared/pass2/referenced_item_ids.txt
#REFERENCED_PERSON_IDS=/shared/pass2/referenced_person_ids.txt
# Optional, and additive: extra items to cache beyond what pass2 referenced.
# Built by build_v1_backfill_seed.py; a missing file is a no-op.
#EXTRA_ITEM_IDS=/shared/seed/v1_backfill_item_ids.txt
